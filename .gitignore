# Project-wide ignores. frontend/, src-tauri/ and backend/internal/webui/
# keep their own .gitignore for their build outputs.

# OS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Local environment and machine-specific settings
.env
.env.*
!.env.example
*.local
.claude/settings.local.json

# Logs
*.log

# Backend build output (make build). backend/docs/ is generated by
# `make swagger` but stays tracked: `make dev` compiles against it.
backend/bin/
*.test
coverage.out

# Claude Code local config (commands/skills generated by openspec init)
.claude/
